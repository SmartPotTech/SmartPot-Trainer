# Token Bearer de las rutas del entrenador (mínimo 16 caracteres). Obligatorio.
SMARTPOT_TRAINER_TOKEN=<TRAINER_SERVICE_TOKEN>
# Token con el que avisa a SmartPot-AI que hay modelos nuevos (por defecto, el mismo del entrenador).
SMARTPOT_AI_TOKEN=<AI_SERVICE_TOKEN>
SMARTPOT_AI_URL=http://ai-smartpot:8000
LOG_LEVEL=INFO
DOCS_ENABLED=false

# Carpeta compartida con SmartPot-AI: SQLite de lecturas y modelos aprendidos (vacía = en memoria).
DATA_DIR=data
# Opcional: leer de TimescaleDB por ADBC con un rol de solo lectura (solo cultivos reales).
# DATABASE_URL=postgresql://smartpot_reader:<CLAVE>@db-smartpot:5432/smartpot
# Zona horaria de la hora local de cada lectura; la misma AI_TIMEZONE de la API.
AI_TIMEZONE=America/Bogota
# Clave privada Ed25519 fuera de /data/models; se crea una sola vez con permisos 0600.
MODEL_SIGNING_KEY_PATH=/data/keys/ed25519_private.pem
# Clave pública fijada (hex) para autenticar los joblib persistidos antes de deserializarlos.
TRUSTED_MODEL_PUBLIC_KEY_HEX=

LEARNING_MIN_SAMPLES=200
LEARNING_RETRAIN_EVERY=300
# Segundos entre revisiones del reentrenamiento (0 lo apaga).
LEARNING_CHECK_SECONDS=120
LEARNING_RETENTION_DAYS=60
